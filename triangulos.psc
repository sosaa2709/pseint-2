	definir lado1, lado2, lado3 como real
	escribir "Ingrese los 3 lados del traingulo"
	leer lado1, lado2, lado3
	si lado1=lado2 y lado1=lado3 entonces escribir "Triangulo equilatero"
	sino si lado1=lado2 entonces escribir "Triangulo isosceles"
		sino si lado1=lado3 entonces escribir "Triangulo isosceles"
				sino si lado2=lado3 entonces escribir "Triangulo isosceles"
			sino escribir "Triangulo escaleno"
	FinSi
