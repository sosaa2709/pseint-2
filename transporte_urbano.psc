Algoritmo transporte_urbano
	definir edad como entero
	escribir "Ingrese la edad y se le mostrara el precio de la tarifa"
	Leer edad
	Borrar Pantalla
	si edad<5 entonces escribir "Gratis"
	sino si edad>=5 y edad <=18 entonces escribir "$150"
			sino escribir "$300"
			FinSi
			finsi
FinAlgoritmo